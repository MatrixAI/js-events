{
  "name": "@matrixai/events",
  "version": "5.0.0",
  "author": "Matrix AI",
  "contributors": [
    {
      "name": "Roger Qiu"
    }
  ],
  "description": "Events for push-flow abstractions",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MatrixAI/js-events.git"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./*": "./dist/*"
  },
  "imports": {
    "#*": "./dist/*"
  },
  "scripts": {
    "prepare": "tsc -p ./tsconfig.build.json",
    "build": "node ./scripts/build.mjs",
    "postversion": "npm install --package-lock-only --ignore-scripts --silent",
    "tsx": "tsx",
    "test": "node ./scripts/test.mjs",
    "lint": "matrixai-lint --check",
    "lintfix": "matrixai-lint --fix"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/tsbuildinfo"
  ]
}
